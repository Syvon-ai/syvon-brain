{
  "name": "syvon-brain",
  "version": "0.1.0",
  "private": true,
  "description": "Syvon Brain: the open-source workspace organism",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build --workspace=@syvon/tool-library && npm run build --workspace=@syvon/organism",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "example": "npm run build && node examples/workspace.mjs",
    "example:work": "npm run build && node examples/work-scope.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "26.1.2",
    "jsdom": "25.0.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
